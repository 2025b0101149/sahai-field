{
  "name": "sahai-field",
  "version": "1.0.0",
  "description": "SahAI Field - Offline-First Edge AI for Rural Fieldwork",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "edge-ai",
    "offline-first",
    "snapdragon-npu",
    "rural-fieldwork",
    "whisper",
    "llm",
    "ocr"
  ],
  "author": "SahAI Field Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
